@page "/issues"
@using LibraryClient.OpenApis
@using LibraryClient.Models
@using Library.Application.Contracts.Issues
@inject LibraryApiWrapper Api
@inject IJSRuntime JS

<style>
    :root {
        --obsidian: #0B0B0D;
        --graphite: #151619;
        --silver: #D7D9DC;
        --champagne: #D6B37A;
        --light-gold: #E8C88D;
        --success: #4CAF50;
        --danger: #DC3545;
    }

    .page-header {
        background: linear-gradient(135deg, var(--obsidian), var(--graphite));
        border-bottom: 3px solid var(--champagne);
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: 0 4px 20px rgba(214, 179, 122, 0.15);
    }

        .page-header h1 {
            color: var(--champagne);
            font-size: 36px;
            letter-spacing: 1px;
        }

    .page-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px 40px;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--champagne), var(--light-gold));
        color: var(--obsidian);
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(214, 179, 122, 0.3);
        }

    .btn-success {
        background: var(--success);
        color: white;
    }

        .btn-success:hover {
            background: #45a049;
            transform: translateY(-2px);
        }

    .btn-danger {
        background: var(--danger);
        color: white;
    }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: rgba(214, 179, 122, 0.1);
        color: var(--champagne);
        border: 2px solid var(--champagne);
    }

        .btn-secondary:hover {
            background: rgba(214, 179, 122, 0.2);
        }

    .form-container {
        background: linear-gradient(135deg, rgba(21, 22, 25, 0.6), rgba(11, 11, 13, 0.8));
        border: 2px solid var(--champagne);
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        backdrop-filter: blur(10px);
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: var(--champagne);
            font-weight: 600;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        background: rgba(11, 11, 13, 0.6);
        border: 2px solid var(--champagne);
        color: var(--silver);
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--light-gold);
            box-shadow: 0 0 15px rgba(214, 179, 122, 0.2);
        }

    .table-wrapper {
        background: linear-gradient(135deg, rgba(21, 22, 25, 0.5), rgba(11, 11, 13, 0.7));
        border: 2px solid var(--champagne);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(214, 179, 122, 0.1);
        backdrop-filter: blur(10px);
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        color: var(--silver);
    }

        .table thead {
            background: linear-gradient(90deg, var(--obsidian), var(--graphite));
            border-bottom: 2px solid var(--champagne);
        }

        .table th {
            color: var(--champagne);
            padding: 18px;
            text-align: left;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .table td {
            padding: 15px 18px;
            border-bottom: 1px solid rgba(214, 179, 122, 0.1);
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

            .table tbody tr:hover {
                background: rgba(214, 179, 122, 0.05);
            }

    .btn-small {
        padding: 8px 16px;
        font-size: 13px;
        margin-right: 5px;
    }

    .loading, .error, .no-data {
        text-align: center;
        padding: 60px 20px;
        color: var(--champagne);
        font-size: 18px;
    }

    .error {
        color: #FFB3B3;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-start;
        margin-top: 20px;
    }
</style>

<div class="page-header">
    <h1>📤 Выдачи книг</h1>
</div>

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading">⏳ Загрузка выдач...</div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="error">❌ Ошибка: @error</div>
    }
    else
    {
        <div class="action-bar">
            <button class="btn btn-primary" @onclick="() => ShowForm = !ShowForm">
                @if (ShowForm)
                {
                    <span>✕ Скрыть форму</span>
                }
                else
                {
                    <span>+ Новая выдача</span>
                }
            </button>
        </div>

        @if (ShowForm)
        {
            <div class="form-container">
                <h3 style="color: var(--champagne); margin-bottom: 20px;">
                    @(isEditing ? "✏️ Редактирование выдачи" : "➕ Новая выдача")
                </h3>

                <div class="form-row">
                    <div class="form-group">
                        <label>📖 Книга:</label>
                        <select class="form-control" @bind="form.BookId">
                            <option value="0">-- Выберите книгу --</option>
                            @foreach (var book in books)
                            {
                                <option value="@book.Id">@book.Title</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>👤 Читатель:</label>
                        <select class="form-control" @bind="form.ReaderId">
                            <option value="0">-- Выберите читателя --</option>
                            @foreach (var reader in readers)
                            {
                                <option value="@reader.Id">@reader.FullName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>📅 Дата выдачи:</label>
                        <input type="date" class="form-control" @bind="form.IssueDate" />
                    </div>

                    <div class="form-group">
                        <label>📆 Количество дней:</label>
                        <input type="number" class="form-control" @bind="form.DaysCount" min="1" max="30" />
                    </div>
                </div>

                <div class="form-group">
                    <label>↩️ Дата возврата (если возвращена):</label>
                    <input type="date" class="form-control" @bind="form.ReturnDate" />
                </div>

                <div class="form-actions">
                    <button class="btn btn-success" @onclick="SaveIssue">💾 Сохранить</button>
                    <button class="btn btn-secondary" @onclick="() => ShowForm = false">✕ Отмена</button>
                </div>
            </div>
        }

        @if (issues is null || issues.Count == 0)
        {
            <div class="no-data">📤 Выдач нет. Добавьте первую выдачу!</div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>📖 Книга</th>
                            <th>👤 Читатель</th>
                            <th>📅 Дата выдачи</th>
                            <th>📆 Дней</th>
                            <th>↩️ Возврат</th>
                            <th>⚙️ Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in issues)
                        {
                            <tr>
                                <td>#@issue.Id</td>
                                <td><strong>@issue.BookTitle</strong></td>
                                <td>@issue.ReaderFullName</td>
                                <td>@issue.IssueDate.ToShortDateString()</td>
                                <td>@issue.DaysCount</td>
                                <td>@(issue.ReturnDate?.ToShortDateString() ?? "❌ Не возвращена")</td>
                                <td>
                                    <button class="btn btn-primary btn-small" @onclick="() => EditIssue(issue)">✏️</button>
                                    <button class="btn btn-danger btn-small" @onclick="() => DeleteIssue(issue.Id)">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private List<IssueDto> issues = [];
    private List<BookClientDto> books = [];
    private List<ReaderClientDto> readers = [];
    private bool isLoading = true;
    private bool ShowForm = false;
    private bool isEditing = false;
    private string? error;

    private IssueForm form = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            issues = await Api.GetIssuesAsync();
            books = await Api.GetBooksAsync();
            readers = await Api.GetReadersAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditIssue(IssueDto issue)
    {
        isEditing = true;
        ShowForm = true;
        form = new IssueForm
        {
            Id = issue.Id,
            BookId = issue.BookId,
            ReaderId = issue.ReaderId,
            IssueDate = issue.IssueDate,
            DaysCount = issue.DaysCount,
            ReturnDate = issue.ReturnDate
        };
    }

    private async Task SaveIssue()
    {
        if (form.BookId == 0 || form.ReaderId == 0)
        {
            error = "Выберите книгу и читателя";
            return;
        }

        try
        {
            var dto = new IssueCreateUpdateDto
            {
                Id = form.Id,
                BookId = form.BookId,
                ReaderId = form.ReaderId,
                IssueDate = form.IssueDate,
                DaysCount = form.DaysCount,
                ReturnDate = form.ReturnDate
            };

            if (isEditing)
            {
                await Api.UpdateIssueAsync(form.Id, dto);
            }
            else
            {
                await Api.CreateIssueAsync(dto);
            }

            ShowForm = false;
            form = new();
            isEditing = false;
            await RefreshIssues();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteIssue(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Удалить выдачу #{id}?"))
        {
            try
            {
                await Api.DeleteIssueAsync(id);
                await RefreshIssues();
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
        }
    }

    private async Task RefreshIssues()
    {
        try
        {
            issues = await Api.GetIssuesAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private class IssueForm
    {
        public int Id { get; set; }
        public int BookId { get; set; }
        public int ReaderId { get; set; }
        public DateTime IssueDate { get; set; } = DateTime.Now;
        public int DaysCount { get; set; } = 14;
        public DateTime? ReturnDate { get; set; }
    }
}
