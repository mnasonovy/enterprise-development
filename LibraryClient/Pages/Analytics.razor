@page "/analytics"
@using LibraryClient.OpenApis
@using LibraryClient.Models
@using Library.Application.Contracts.Issues
@inject LibraryApiWrapper Api
@inject IJSRuntime JS

<PageTitle>Library Manager - Аналитика</PageTitle>

<link href="css/index.css" rel="stylesheet" />

<div class="hero-accent"></div>
<div class="hero-accent-left"></div>

<div class="navbar">
    <a href="/" class="navbar-brand">Library Manager</a>
    <ul class="nav-links">
        <li><a href="/books">📖 Книги</a></li>
        <li><a href="/readers">👥 Читатели</a></li>
        <li><a href="/issues">📤 Выдачи</a></li>
        <li><a href="/analytics">📊 Аналитика</a></li>
    </ul>
</div>

<div class="container">
    <div class="welcome-section">
        <h1 class="welcome-title">📊 Аналитика и статистика</h1>
        <p class="welcome-subtitle">Детальный анализ деятельности библиотеки</p>
    </div>

    @if (isLoading)
    {
        <div class="loading" style="margin: 80px 0;">⏳ Загрузка данных аналитики...</div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="error" style="margin: 80px 0;">❌ Ошибка загрузки: @error</div>
    }
    else
    {
        <!-- ОСНОВНЫЕ МЕТРИКИ -->
        <div class="animate-up">
            <h2 class="section-title" style="margin-top: 60px;">🎯 Основные метрики</h2>
            <div class="welcome-cards">
                <div class="stat-card">
                    <div class="stat-icon">📚</div>
                    <div class="stat-number">@totalIssues</div>
                    <div class="stat-label">Всего выдач</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📤</div>
                    <div class="stat-number">@activeIssues</div>
                    <div class="stat-label">На руках</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">✅</div>
                    <div class="stat-number">@returnedIssues</div>
                    <div class="stat-label">Возвращено</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⏰</div>
                    <div class="stat-number">@overdueIssues</div>
                    <div class="stat-label">Просроченных</div>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <!-- ЭФФЕКТИВНОСТЬ -->
        <div class="animate-up">
            <h2 class="section-title">📈 Эффективность</h2>
            <div class="charts-grid">
                <div class="chart-card">
                    <h3>Распределение выдач</h3>
                    <div style="padding: 20px; text-align: center;">
                        <div style="font-size: 48px; font-weight: 900; color: var(--champagne); margin-bottom: 10px;">@returnPercentage%</div>
                        <p style="color: var(--silver); opacity: 0.8;">Книг возвращено</p>
                        <div style="margin-top: 20px; background: rgba(214, 179, 122, 0.2); border-radius: 10px; overflow: hidden; height: 10px;">
                            <div style="background: linear-gradient(90deg, var(--champagne), var(--light-gold)); height: 100%; width: @(returnPercentage)%;"></div>
                        </div>
                    </div>
                </div>

                <div class="chart-card">
                    <h3>Просроченные выдачи</h3>
                    <div style="padding: 20px; text-align: center;">
                        <div style="font-size: 48px; font-weight: 900; color: #ff6b6b; margin-bottom: 10px;">@overdueIssues</div>
                        <p style="color: var(--silver); opacity: 0.8;">@(overdueIssues == 0 ? "Всё в порядке! ✅" : "Требуют внимания! ⚠️")</p>
                        <div style="margin-top: 20px; font-size: 14px; color: var(--silver); opacity: 0.7;">
                            @if (totalIssues > 0)
                            {
                                <p>@(Math.Round((double)overdueIssues / totalIssues * 100, 1))% от всех выдач</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <!-- ПОПУЛЯРНЫЕ КНИГИ -->
        <div class="animate-up">
            <h2 class="section-title">🏆 Топ-10 популярных книг</h2>
            @if (popularBooks is null || popularBooks.Count == 0)
            {
                <div class="error" style="text-align: center; padding: 40px;">Нет данных о выданных книгах</div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 25px;">
                    @foreach (var book in popularBooks)
                    {
                        <div class="feature-card" style="border-left: 5px solid var(--light-gold);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                                <div class="feature-title" style="margin: 0;">📖 @book.BookTitle</div>
                                <div style="background: linear-gradient(135deg, var(--champagne), var(--light-gold)); color: var(--obsidian); padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 14px;">
                                    @book.IssueCount выдач
                                </div>
                            </div>
                            <div style="background: rgba(214, 179, 122, 0.1); border-radius: 8px; padding: 12px; font-size: 13px; color: var(--silver); opacity: 0.8;">
                                Популярность: @(Math.Min(book.IssueCount * 10, 100))%
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="divider"></div>

        <!-- АКТИВНЫЕ ЧИТАТЕЛИ -->
        <div class="animate-up">
            <h2 class="section-title">👥 Топ-10 активных читателей</h2>
            @if (activeReaders is null || activeReaders.Count == 0)
            {
                <div class="error" style="text-align: center; padding: 40px;">Нет данных о читателях</div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 25px;">
                    @foreach (var reader in activeReaders)
                    {
                        <div class="feature-card" style="border-left: 5px solid #5dade2;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                                <div class="feature-title" style="margin: 0;">👤 @reader.ReaderFullName</div>
                                <div style="background: linear-gradient(135deg, #5dade2, #85c1e2); color: var(--obsidian); padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 14px;">
                                    @reader.BookCount книг
                                </div>
                            </div>
                            <div style="background: rgba(93, 173, 226, 0.1); border-radius: 8px; padding: 12px; font-size: 13px; color: var(--silver); opacity: 0.8;">
                                Активность: @(Math.Min(reader.BookCount * 10, 100))%
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="divider"></div>

        <!-- ТАБЛИЦА ПРОСРОЧЕННЫХ -->
        <div class="animate-up">
            <h2 class="section-title">⚠️ Просроченные выдачи</h2>
            @if (overdueIssuesList is null || overdueIssuesList.Count == 0)
            {
                <div style="background: linear-gradient(135deg, rgba(93, 195, 125, 0.1), rgba(46, 125, 50, 0.1)); border: 2px solid #5cc37d; border-radius: 12px; padding: 40px; text-align: center;">
                    <div style="font-size: 48px; margin-bottom: 15px;">✅</div>
                    <p style="color: var(--silver); font-size: 18px; font-weight: 600;">Отлично! Нет просроченных выдач</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 3px solid var(--champagne);">
                                <th style="padding: 15px; text-align: left; color: var(--champagne); font-weight: 700;">Выдача ID</th>
                                <th style="padding: 15px; text-align: left; color: var(--champagne); font-weight: 700;">Дата выдачи</th>
                                <th style="padding: 15px; text-align: left; color: var(--champagne); font-weight: 700;">Срок (дней)</th>
                                <th style="padding: 15px; text-align: left; color: var(--champagne); font-weight: 700;">Дней задержки</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in overdueIssuesList)
                            {
                                var daysOverdue = (int)(DateTime.Now - issue.IssueDate.AddDays(issue.DaysCount)).TotalDays;
                                <tr style="border-bottom: 1px solid rgba(214, 179, 122, 0.2); background: rgba(255, 107, 107, 0.05);">
                                    <td style="padding: 15px; color: var(--silver);">@issue.Id</td>
                                    <td style="padding: 15px; color: var(--silver);">@issue.IssueDate.ToString("dd.MM.yyyy")</td>
                                    <td style="padding: 15px; color: var(--silver);">@issue.DaysCount</td>
                                    <td style="padding: 15px;">
                                        <span style="background: #ff6b6b; color: white; padding: 5px 12px; border-radius: 20px; font-weight: 700; font-size: 12px;">
                                            @daysOverdue дней
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? error;
    private List<IssueDto> issues = [];
    private int totalIssues;
    private int activeIssues;
    private int returnedIssues;
    private int overdueIssues;
    private int returnPercentage;
    private List<BookStats> popularBooks = [];
    private List<ReaderStats> activeReaders = [];
    private List<IssueDto> overdueIssuesList = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            issues = await Api.GetIssuesAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStats()
    {
        totalIssues = issues.Count;
        activeIssues = issues.Count(i => i.ReturnDate == null);
        returnedIssues = issues.Count(i => i.ReturnDate != null);
        returnPercentage = totalIssues == 0 ? 0 : (int)((double)returnedIssues / totalIssues * 100);

        var now = DateTime.Now;
        overdueIssuesList = issues
            .Where(i => i.ReturnDate == null && i.IssueDate.AddDays(i.DaysCount) < now)
            .OrderBy(i => i.IssueDate)
            .ToList();
        overdueIssues = overdueIssuesList.Count;

        // Популярные книги (по BookId так как Title может быть недоступен)
        popularBooks = issues
            .GroupBy(i => i.BookTitle)
            .Where(g => !string.IsNullOrEmpty(g.Key))
            .Select(g => new BookStats
            {
                BookTitle = g.Key ?? "Неизвестная книга",
                IssueCount = g.Count()
            })
            .OrderByDescending(x => x.IssueCount)
            .Take(10)
            .ToList();

        // Активные читатели (по ReaderId и ReaderFullName)
        activeReaders = issues
            .GroupBy(i => i.ReaderFullName)
            .Where(g => !string.IsNullOrEmpty(g.Key))
            .Select(g => new ReaderStats
            {
                ReaderFullName = g.Key ?? "Неизвестный читатель",
                BookCount = g.Count()
            })
            .OrderByDescending(x => x.BookCount)
            .Take(10)
            .ToList();
    }

    private class BookStats
    {
        public string BookTitle { get; set; } = string.Empty;
        public int IssueCount { get; set; }
    }

    private class ReaderStats
    {
        public string ReaderFullName { get; set; } = string.Empty;
        public int BookCount { get; set; }
    }
}
